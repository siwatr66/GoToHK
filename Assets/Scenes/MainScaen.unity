  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b1b1198fa5b13d047b3edb9610bc8681, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractableTarget
  targetTitle: USS Johnston
  subTitle: 
  descriptionParagraphs:
  - "In 1944, the USS Johnston sank after a battle against the world's largest battleship.
    More than 75 years later, her wreck was finally located, 6km (3.7 miles) below
    the waves.\r\n\r\nOn 23 October 1944, the first engagements of a gigantic naval
    battle began in Leyte Gulf, part of the Philippine Sea. It was the biggest in
    modern human history.\r\n\r\nOver the following three days, more than 300 US
    warships faced off against some 70 Japanese vessels. The Americans had with them
    no fewer than 34 aircraft carriers \u2013 only slightly fewer than all the carriers
    in service around the world today \u2013 and some 1,500 aircraft. Their air fleet
    outnumbered the Japanese five to one.\r\n"
  displayImages:
  - {fileID: 21300000, guid: 40229f1b8927edb4185651aceee01ca5, type: 3}
